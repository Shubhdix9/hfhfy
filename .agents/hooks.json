{
  "krishisetu-release-gate": {
    "enabled": true,
    "PostToolUse": [
      {
        "matcher": "replace_file_content|write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "node scripts/krishisetu-audit.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node scripts/krishisetu-prepush.mjs",
        "timeout": 30
      }
    ]
  }
}
