# ==============================================================================
# KrishiSetu Platform - Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to .env for local development.
# On Vercel, configure these under Project Settings -> Environment Variables.
# NEVER commit .env to version control or expose server keys in client code!

# ------------------------------------------------------------------------------
# 1. Google Maps Platform (Client-Side Key)
# ------------------------------------------------------------------------------
# In Google Cloud Console:
# 1. Enable 'Maps JavaScript API', 'Places API (New)', and 'Geocoding API'.
# 2. Under Credentials, create an API key and restrict it by HTTP Referrer:
#    - http://localhost:5173/* (for local dev)
#    - https://*.vercel.app/* (for Vercel preview deployments)
#    - https://your-production-domain.com/* (production)
# 3. Create a Map ID in Maps Management (Raster / Vector).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyPlaceholder_Your_Browser_Key
VITE_GOOGLE_MAP_ID=your_google_map_id_optional

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (PostgreSQL Database & Auth)
# ------------------------------------------------------------------------------
# From your Supabase Project Settings -> API:
# SUPABASE_URL: Project URL (e.g., https://xyzcompany.supabase.co)
# SUPABASE_ANON_KEY: Public anonymous key protected by Row Level Security (RLS)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-publishable-key

# Server-side Supabase Service Role Key (ONLY for secure administrative scripts/cron; NEVER in client)
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# 3. AGMARKNET / Open Government Data Platform India (Server-Only Secret)
# ------------------------------------------------------------------------------
# Catalog: Current Daily Price of Various Commodities from Various Markets (Mandi)
# URL: https://www.data.gov.in/catalog/current-daily-price-various-commodities-various-markets-mandi
#
# OPTION A (College Project Mode — Instant, Zero Setup):
# Set DATA_GOV_IN_API_KEY=college to automatically load official AGMARKNET benchmark
# daily wholesale rates for Jaipur Muhana Mandi & Rajasthan markets.
#
# OPTION B (Official Free data.gov.in API Key):
# Register at https://data.gov.in (As a student: select Category = "Academic / Student",
# Organization = Your College Name, Designation = "Student"). Copy key from My Account.
DATA_GOV_IN_API_KEY=college

# ------------------------------------------------------------------------------
# 4. India Meteorological Department (IMD) / Weather Service
# ------------------------------------------------------------------------------
# Official Portal: https://mausam.imd.gov.in/jaipur/
# Official API: https://api.imd.gov.in/public/api_reference.html
# Station ID for Jaipur Met Centre: 42348
IMD_API_KEY=optional_imd_key_if_subscribed
IMD_JAIPUR_STATION_ID=42348

# ------------------------------------------------------------------------------
# 5. Cashfree PG & Direct NPCI UPI Payment Gateway (Server-Only Secrets)
# ------------------------------------------------------------------------------
# Register on Cashfree Payments (https://www.cashfree.com/)
# Obtain your App ID & Secret Key from Merchant Dashboard -> Developers -> API Keys
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key
CASHFREE_ENVIRONMENT=TEST # TEST for Sandbox, PROD for Production

# Default Platform Escrow / Payee VPA for Direct NPCI UPI Payments
PLATFORM_DEFAULT_UPI_VPA=krishisetu.escrow@upi
PLATFORM_DEFAULT_PAYEE_NAME=KrishiSetu Escrow

# ------------------------------------------------------------------------------
# 6. Application Cache & Operational Settings
# ------------------------------------------------------------------------------
CACHE_TTL_MANDI_SECONDS=3600
CACHE_TTL_WEATHER_SECONDS=1800
DEFAULT_MAP_RADIUS_KM=25

# ------------------------------------------------------------------------------
# 7. Cloudflare R2 Storage (Homepage Background Video Streaming)
# ------------------------------------------------------------------------------
# Server-side upload credentials (strictly secret; NEVER prefix with VITE_):
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name
# R2_PUBLIC_BASE_URL=https://pub-xxxxxx.r2.dev

# Client-side public streaming URL (safe for browser; empty falls back to local file):
VITE_HOMEPAGE_VIDEO_URL=
